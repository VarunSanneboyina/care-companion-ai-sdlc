+# Care Companion: intent.md (v1.1)
 
 ## Purpose
 Help patients with diabetes log HbA1c readings, and let care coordinators see who needs follow-up.
@@ -24,8 +24,15 @@ Help patients with diabetes log HbA1c readings, and let care coordinators see wh
 - A submitted reading appears in the list immediately.
 - HbA1c values outside 3.0 to 20.0 are rejected.
 
+## Change 1.1: Hypertension tracking
+- Patients submit blood pressure (systolic and diastolic) alongside HbA1c.
+- The list shows the latest reading and an "Above target" flag (sample target, set by clinicians).
+- Systolic must be higher than diastolic; impossible values are rejected.
+- Acceptance: invalid readings are rejected; valid ones appear immediately.
+
 ## Decisions
 
 | # | Decision | Owner | Status | Resolution |
 | --- | --- | --- | --- | --- |
 | D1 | Demo uses sample data only | Product owner | Resolved | Yes, no real patient data |
+| D2 | Who approves the "Above target" blood pressure thresholds? | Clinical lead | Open | |
diff --git a/tests/logic.test.js b/tests/logic.test.js
index 0d68c8e..94f981a 100644
--- a/tests/logic.test.js
+++ b/tests/logic.test.js
@@ -38,3 +38,28 @@ test('sort orders by latest HbA1c', () => {
   assert.strictEqual(L.sortByLatest(l, 'desc')[0].name, 'B');
   assert.strictEqual(L.sortByLatest(l, 'asc')[0].name, 'A');
 });
+
+// Change 1.1: hypertension tracking
+test('blood pressure with systolic above diastolic is accepted', () => {
+  assert.strictEqual(L.validateBP('120', '80').ok, true);
+});
+test('impossible blood pressure is rejected', () => {
+  assert.strictEqual(L.validateBP('80', '120').ok, false);
+  assert.strictEqual(L.validateBP('120', '120').ok, false);
+  assert.strictEqual(L.validateBP('900', '80').ok, false);
+  assert.strictEqual(L.validateBP('', '80').ok, false);
+});
+test('valid blood pressure reading appears immediately', () => {
+  const p = { name: 'T', readings: [{ a1c: 7, date: '2026-01-01' }] };
+  assert.strictEqual(L.addReading(p, '7.2', '2026-02-01', '125', '82').ok, true);
+  assert.strictEqual(L.latest(p).sys, 125);
+});
+test('invalid blood pressure reading is not stored', () => {
+  const p = { name: 'T', readings: [{ a1c: 7, date: '2026-01-01' }] };
+  assert.strictEqual(L.addReading(p, '7.2', '2026-02-01', '80', '125').ok, false);
+  assert.strictEqual(p.readings.length, 1);
+});
+test('blood pressure status uses the configured target', () => {
+  assert.strictEqual(L.bpStatus(L.CONFIG.bpSystolicTarget + 1, 70), 'Above target');
+  assert.strictEqual(L.bpStatus(110, 70), 'At or below target');
+});
